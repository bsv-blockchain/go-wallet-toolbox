# ================================================================================================
# 🏗️ PROJECT-SPECIFIC CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for this repository
# Load Order: 90 (loaded after all defaults, overrides earlier files)
#
# This file contains configuration values that are specific to this project
# and override the defaults defined in earlier env files (00-core, 10-*, 20-*).
#
# Only add variables here that differ from the defaults.
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

# Primary Go version for builds and primary test runner
GO_PRIMARY_VERSION=1.26.3

# Secondary Go version for compatibility testing
GO_SECONDARY_VERSION=1.26.3

# MAGE-X Go version overrides
MAGE_X_GO_VERSION=1.26.3
MAGE_X_GO_SECONDARY_VERSION=1.26.3

# Govulncheck-specific Go version (overrides 00-core.env's 1.26.5).
# 1.26.5's standard library is affected by several vulnerabilities fixed in
# 1.26.6 (net/url, html/template, crypto/tls, net/http, encoding/xml,
# encoding/asn1, golang.org/x/net/idna). The govulncheck job pins its own Go
# version and installs it with GOTOOLCHAIN=local, so a go.mod `toolchain`
# directive alone does not affect it — bump this value here instead.
GOVULNCHECK_GO_VERSION=1.26.6

# ================================================================================================
# 📊 COVERAGE OVERRIDES
# ================================================================================================

# Custom Coverage Exclusions (overrides 10-coverage.env)
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,docs/,example/,examples/,mocks/,plans/,test/,testing/,testdata/,vendor/

# Coverage Provider (overrides 10-coverage.env)
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration (overrides 10-coverage.env)
CODECOV_TOKEN_REQUIRED=true

# ================================================================================================
# 🔒 SECURITY CONFIGURATION
# ================================================================================================

# Nancy CVE Exclusions (known acceptable vulnerabilities)
NANCY_EXCLUDES=CVE-2026-26014,CVE-2026-26958,CVE-2025-15558,CVE-2023-26248,CVE-2026-26958,CVE-2026-33809,CVE-2026-33747,CVE-2026-33748,CVE-2026-34986,CVE-2026-33815,CVE-2026-33816,CVE-2026-39882,CVE-2026-35469,CVE-2026-5160,CVE-2026-33812,CVE-2026-33813,CVE-2026-46599,CVE-2026-42500,CVE-2026-46601,CVE-2026-46602,CVE-2026-46604,CVE-2026-47262,CVE-2026-50195,CVE-2026-53488,CVE-2026-53489,CVE-2026-53492,CVE-2026-45045,CVE-2026-53624,CVE-2026-15789,CVE-2026-15792,CVE-2026-15788,CVE-2026-15791,CVE-2026-54908,CVE-2026-49834,CVE-2026-54787

# Govulncheck/Magex CVE Exclusions
MAGE_X_CVE_EXCLUDES=CVE-2026-26014,CVE-2026-26958,CVE-2025-15558,CVE-2023-26248,CVE-2026-26958,CVE-2026-33809,CVE-2026-33747,CVE-2026-33748,CVE-2026-34986,CVE-2026-33815,CVE-2026-33816,CVE-2026-39882,CVE-2026-35469,CVE-2026-5160,CVE-2026-33812,CVE-2026-33813,GO-2026-5932

# ================================================================================================
# 🏗️ BUILD OPTIMIZATION
# ================================================================================================

# Skip pre-building packages during cache warming to prevent OOM kills.
# Even batch_size=3 with GOGC=50 exceeds the ~7GB available on standard runners
# because heavy packages (cmd/certifier, cmd/infra) pull in the entire dependency
# tree (libp2p, k8s, googleapis, etc.).
# The module cache (go mod download) is still warmed — that provides the biggest
# speedup. Build artifacts get cached naturally after the first real build job.
MAGE_X_BUILD_STRATEGY=skip
