# Local TSTN throughput dashboard secrets / private endpoints.
# Copy to .env.tstn (gitignored) and fill in real values. Do not commit .env.tstn.
#
#   cp .env.tstn.example .env.tstn
#   docker compose \
#     -f docker-compose.throughput-dashboard.yaml \
#     -f docker-compose.throughput-dashboard.tstn.override.yaml \
#     --env-file .env.tstn \
#     up --build

# Operator wallet (hex). Required.
PRIVATE_KEY=

# Private Arcade base URL (broadcast + ARC-compatible merkle). Required for tstn.
# Example shape only — use your deployment host:
# TSTN_ARCADE_URL=https://arcade.example.internal
TSTN_ARCADE_URL=

# Optional ChainTracks base (go-chaintracks client appends /v2/...). Defaults to
# ${TSTN_ARCADE_URL}/chaintracks when unset — do not add a trailing /v1 or /v2.
# TSTN_CHAINTRACKS_URL=https://arcade.example.internal/chaintracks
# TSTN_CHAINTRACKS_URL=

# Optional stream defaults (compose already defaults these)
# TPS=10
# WORKERS=0   # 0 = auto from TPS; set >0 only to force a pool size
# SAMPLE_SECONDS=1
# ORIGINATOR=throughput-dashboard.local
