# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

.opencode

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.tstn

# Local TSTN throughput dashboard override (copy from *.example; holds private wiring)
docker-compose.throughput-dashboard.tstn.override.yaml

# Jetbrains
.idea/
*.iml

# OSX
.DS_Store

# Local configs
infra-config.yaml
infra-config.*.yaml
!infra-config.example.yaml
chaintracks-config.yaml
chaintracks-config.*.yaml
!chaintracks-config.example.yaml
certifier-config.yaml
certifier-config.*.yaml
!certifier-config.example.yaml

# SQLite databases
storage.sqlite
storage.*.sqlite
storage.sqlite-journal
storage.sqlite-wal
storage.sqlite-shm
storage.*.sqlite-wal
storage.*.sqlite-shm

# Example config
examples/examples-config.yaml

# Manual tests
manual_tests/*.sqlite
manual_tests/*.log
manual_tests/*.sqlite-journal
manual_tests/*.sqlite-wal
manual_tests/*.sqlite-shm

# Fuzz Tests
testdata

# Build output
bin/

.worktrees/
