# syntax=docker/dockerfile:1

# =============================================================================
# Builder stage — throughput infra + loadgen
# =============================================================================
# Pinned by digest only (Scorecard Pinned-Dependencies); the digest points at
# the multi-arch manifest list, preserving linux/amd64 + linux/arm64 support.
# The tag is omitted on purpose (Docker ignores it alongside a digest, and
# using both trips SonarQube docker:S7018).
# golang:1.27-alpine
FROM golang@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS builder

RUN apk add --no-cache ca-certificates git tzdata

WORKDIR /src

# Cache go modules
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build throughput infra server and loadgen (static, small)
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /out/infra \
    ./cmd/infra_throughput
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /out/loadgen \
    ./cmd/throughput_loadgen

# =============================================================================
# Runtime stage
# =============================================================================
# alpine:3.20
FROM alpine@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc

RUN apk add --no-cache ca-certificates curl postgresql-client tzdata \
    && adduser -D -H -u 1000 app

WORKDIR /app

COPY --from=builder /out/infra /app/infra
COPY --from=builder /out/loadgen /app/loadgen

# Default throughput config; override via volume mount in compose
COPY infra-config-docker-throughput.yaml /app/infra-config-throughput.yaml

RUN mkdir -p /app/data \
    && chown -R app:app /app

USER app

EXPOSE 8100

# Default entry is infra; loadgen service overrides entrypoint
ENTRYPOINT ["/app/infra"]
