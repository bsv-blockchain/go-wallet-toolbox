# syntax=docker/dockerfile:1

# =============================================================================
# Builder stage — throughput infra + loadgen
# =============================================================================
# Pinned by tag + digest (Scorecard Pinned-Dependencies). The digest points at
# the multi-arch manifest list, preserving linux/amd64 + linux/arm64 support and
# reproducibility; the tag is kept so Dependabot preserves the -alpine variant on
# bumps (a digest alone is variant-ambiguous and can flip the builder to Debian,
# which has no `apk`).
FROM golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS builder

RUN apk add --no-cache ca-certificates git tzdata

WORKDIR /src

# Cache go modules
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build throughput infra server and loadgen (static, small)
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /out/infra \
    ./cmd/infra_throughput
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /out/loadgen \
    ./cmd/throughput_loadgen

# =============================================================================
# Runtime stage
# =============================================================================
FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

RUN apk add --no-cache ca-certificates curl postgresql-client tzdata \
    && adduser -D -H -u 1000 app

WORKDIR /app

COPY --from=builder /out/infra /app/infra
COPY --from=builder /out/loadgen /app/loadgen

# Default throughput config; override via volume mount in compose
COPY infra-config-docker-throughput.yaml /app/infra-config-throughput.yaml

RUN mkdir -p /app/data \
    && chown -R app:app /app

USER app

EXPOSE 8100

# Default entry is infra; loadgen service overrides entrypoint
ENTRYPOINT ["/app/infra"]
